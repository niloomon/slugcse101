#!/bin/bash

#  Converts every markdown page of this folder to html and pushes everything to GitHub,
#  which publishes it at https://niloomon.github.io
#  Usage:  ./update                     commits with the message "Update"
#          ./update "Add new paper"     commits with the given message
#
#  Works on both macOS and Linux.

set -e

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

message="${1:-Update}"

#    Convert all the markdown files.
find . -type f -name "*.md" -not -path "./.git/*" -print0 > /tmp/md2html_files.$$
while IFS= read -r -d '' file; do
   ( cd "$(dirname "$file")" && "$ROOT/md2html" "$(basename "$file")" )
done < /tmp/md2html_files.$$
rm -f /tmp/md2html_files.$$

#    Push to GitHub.
git add -A
if git diff --cached --quiet; then
   echo "Nothing to commit."
else
   git commit -m "$message"
fi
git push

echo "Published. It may take a minute to appear at https://niloomon.github.io"
